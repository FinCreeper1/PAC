{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"pac-install",
 "main":"src/index.js",
 "compatibility_date":"2026-09-10",
 "compatibility_flags":["nodejs_compat"],
 "assets":{"directory":"public","binding":"ASSETS","run_worker_first":true},
 "durable_objects":{"bindings":[{"name":"JOBS","class_name":"InstallJob"},{"name":"LIMITS","class_name":"InstallLimits"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["InstallJob","InstallLimits"]}],
 "rules":[{"type":"Text","globs":["**/generated/*.txt"],"fallthrough":true}],
 "vars":{"OAUTH_CLIENT_ID":"eb65174a9250c1559060e73acc38507f"},
 "observability":{"enabled":false}
}
